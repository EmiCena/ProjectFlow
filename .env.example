# Django - local usa localhost, Railway sobreescribe con env del dashboard
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app,.railway.app
DATABASE_URL=postgres://projectflow:projectflow@postgres:5432/projectflow
MONGO_URI=mongodb://mongo:27017/projectflow
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://projectflow-web-production-981d.up.railway.app
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.railway.app

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI - OpenRouter (primary) + Gemini fallback
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Frontend - en Railway pon VITE_API_URL=https://projectflow-api-production.up.railway.app/api
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=ProjectFlow
